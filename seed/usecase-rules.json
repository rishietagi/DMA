{
  "meta": {
    "note": "Full rule library — 28 rules covering every function. when fields are ANDed; capabilityIds OR-matched; score uses the effective dimension score."
  },
  "rules": [
    {
      "id": "uc-ecom-recon-agent",
      "when": {
        "capabilityIds": [
          "ecom-reconciliation",
          "nmt-reconciliation"
        ],
        "dimension": "process",
        "maxScore": 2
      },
      "useCase": {
        "title": "Agentic marketplace reconciliation",
        "description": "Agent matches settlements, deductions and claims to invoices; drafts disputes; humans approve exceptions.",
        "aiPattern": "Agentic workflow + document understanding",
        "kpis": [
          "Deduction leakage",
          "DSO",
          "Recon effort (FTE hrs)"
        ],
        "dataPrerequisites": [
          "Settlement reports",
          "Invoice & credit-note data"
        ],
        "effort": "M",
        "dependsOn": [
          "uc-platform-po-integration"
        ]
      }
    },
    {
