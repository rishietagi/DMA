      "useCase": {
        "title": "Unified platform PO ingestion",
        "description": "Single integration layer ingests POs from all marketplaces/MT chains, validates against ATP and pricing, posts to SAP.",
        "aiPattern": "Integration + rules-based validation",
        "kpis": [
          "PO-to-dispatch TAT",
          "Fill rate"
        ],
        "dataPrerequisites": [
          "Platform APIs/EDI",
          "Price master"
        ],
        "effort": "M",
        "dependsOn": []
      }
