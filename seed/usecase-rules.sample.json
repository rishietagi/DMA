{
  "meta": {
    "note": "SAMPLE — expand to ~25 rules covering every function. 'when' fields are ANDed; capabilityIds OR-matched; score uses effective dimension score."
  },
  "rules": [
    {
      "id": "uc-ecom-recon-agent",
      "when": {
        "capabilityIds": [
          "ecom-reconciliation",
          "nmt-reconciliation"
        ],
        "dimension": "process",
        "maxScore": 2
      },
      "useCase": {
        "title": "Agentic marketplace reconciliation",
        "description": "Agent matches settlements, deductions and claims to invoices; drafts disputes; humans approve exceptions.",
        "aiPattern": "Agentic workflow + document understanding",
        "kpis": [
          "Deduction leakage",
          "DSO",
          "Recon effort (FTE hrs)"
        ],
        "dataPrerequisites": [
          "Settlement reports",
          "Invoice & credit-note data"
        ],
        "effort": "M",
        "dependsOn": [
          "uc-platform-po-integration"
        ]
      }
    },
    {
      "id": "uc-platform-po-integration",
      "when": {
        "capabilityIds": [
          "ecom-order-induction",
          "nmt-order-induction"
        ],
        "dimension": "process",
        "maxScore": 2.5
      },
      "useCase": {
        "title": "Unified platform PO ingestion",
        "description": "Single integration layer ingests POs from all marketplaces/MT chains, validates against ATP and pricing, posts to SAP.",
        "aiPattern": "Integration + rules-based validation",
        "kpis": [
          "PO-to-dispatch TAT",
          "Fill rate"
        ],
        "dataPrerequisites": [
          "Platform APIs/EDI",
          "Price master"
        ],
        "effort": "M",
        "dependsOn": []
      }
    },
    {
      "id": "uc-slot-optimiser",
      "when": {
        "capabilityIds": [
          "ecom-appointment",
          "nmt-appointment"
        ],
        "dimension": "process",
        "maxScore": 2
      },
      "useCase": {
        "title": "Appointment slot optimiser",
        "description": "Auto-books and re-books DC/dark-store slots from the dispatch plan; predicts appointment misses.",
        "aiPattern": "Optimisation + predictive alerts",
        "kpis": [
          "Appointment adherence",
          "Fill rate"
        ],
        "dataPrerequisites": [
          "Dispatch plan",
          "Platform slot data"
        ],
        "effort": "S",
        "dependsOn": [
          "uc-platform-po-integration"
        ]
      }
    },
    {
      "id": "uc-ml-forecast",
      "when": {
        "capabilityIds": [
          "sales-demand-forecasting"
        ],
        "dimension": "data",
        "maxScore": 3
      },
      "useCase": {
        "title": "ML demand sensing by channel",
        "description": "Driver-based ML forecast at SKU × channel × region, fed into IBP consensus.",
        "aiPattern": "Time-series ML",
        "kpis": [
          "Forecast accuracy (MAPE)",
          "Fill rate",
          "Inventory days"
        ],
        "dataPrerequisites": [
          "Clean SKU/customer master",
          "3y sales history"
        ],
        "effort": "L",
        "dependsOn": [
          "uc-mdm-quality"
        ]
      }
    },
    {
      "id": "uc-fillrate-rca",
      "when": {
        "capabilityIds": [
          "scm-dashboard"
        ],
        "dimension": "process",
        "maxScore": 3
      },
      "useCase": {
        "title": "Fill-rate root-cause copilot",
        "description": "Automatically attributes shortfalls to forecast, supply, MDM or logistics causes and suggests actions.",
        "aiPattern": "Analytics + GenAI narrative",
        "kpis": [
          "Customer fill rate",
          "OTIF"
        ],
        "dataPrerequisites": [
          "Order lines",
          "Inventory snapshots"
        ],
        "effort": "M",
        "dependsOn": [
          "uc-ml-forecast"
        ]
      }
    },
